# Keep sops dotenv files LF-only. CRLF can break sops metadata parsing on Windows.
.env.sops text eol=lf
.sops.yaml text eol=lf
PROJECT_CONTEXT_PACK.md text eol=lf

# Deterministic cross-platform text normalization.
* text=auto

# LF-only source/docs/config formats.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.sql text eol=lf

# Windows-native script formats.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf

# Binary formats.
*.png binary
*.gz binary

