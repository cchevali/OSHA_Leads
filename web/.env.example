# Marketing site public env (client-safe)
#
# Enable Plausible only in production to avoid localhost / preview pollution.
# Values are read at runtime in the browser (NEXT_PUBLIC_*).

# Set to "true" in Vercel Production only.
NEXT_PUBLIC_PLAUSIBLE_ENABLED=false

# The Plausible site domain (usually your apex domain).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=microflowops.com

# Allowed hostnames to track analytics on (comma-separated).
# Recommend: microflowops.com
NEXT_PUBLIC_SITE_HOST=microflowops.com

# Trial request SMTP (server-side only, do not prefix with NEXT_PUBLIC_)
WEB_SMTP_HOST=
WEB_SMTP_PORT=
WEB_SMTP_USER=
WEB_SMTP_PASS=
WEB_SMTP_FROM=support@microflowops.com
# Optional; defaults to support@microflowops.com when unset.
WEB_TRIAL_TO=support@microflowops.com
